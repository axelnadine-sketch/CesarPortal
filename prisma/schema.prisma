generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(120)
  slug             String   @unique @db.VarChar(140)
  url              String   @db.VarChar(512)
  shortDescription String   @db.VarChar(240)
  longDescription  String?  @db.Text
  category         String   @db.VarChar(80)
  tags             String?
  imageUrl         String   @db.VarChar(512)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

model Project {
  id               String   @id @default(cuid())
  name             String   @db.VarChar(140)
  slug             String   @unique @db.VarChar(160)
  status           String   @default("A_REPRENDRE") @db.VarChar(40)
  priority         String   @default("MOYENNE") @db.VarChar(40)
  shortDescription String   @db.VarChar(280)
  nextAction       String?  @db.Text
  usefulLinks      String?  @db.Text
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([isActive, sortOrder])
}
